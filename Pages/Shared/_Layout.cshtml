<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Guichet Automatique</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-guichet">
    <div class="conteneur-atm shadow-lg">
        <div class="ecran-atm-entete d-flex justify-content-between align-items-center px-4 py-3">
            <span class="fw-bold">🏦 GUICHET AUTOMATIQUE ACAFIS-BANK</span>
            <span class="small text-muted">@DateTime.Now.ToString("dddd d MMMM yyyy, HH:mm", new System.Globalization.CultureInfo("fr-CA"))</span>
        </div>
        <div class="ecran-atm-corps p-4">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
